# Public site URL (optional locally; production uses https://artchunk.com in code)
NEXT_PUBLIC_SITE_URL=https://artchunk.com

# Google Search Console HTML tag verification value (content=...)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend transactional email (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@artchunk.com
ENQUIRY_FROM_EMAIL=Artchunk <hello@artchunk.com>
