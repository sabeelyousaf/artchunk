# Public site URL (optional locally; production uses https://artchunk.com in code)
NEXT_PUBLIC_SITE_URL=https://artchunk.com

# Google Search Console HTML tag verification value (content=...)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Gmail SMTP (use a Google App Password, not the normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where enquiry notifications are delivered / shown as sender
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=Artchunk <you@gmail.com>
